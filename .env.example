# .env.example — Template bien moi truong cho OTA_KG Vietnamese
#
# Cach dung:
#   1. Copy file nay: cp .env.example .env   (hoac copy thu cong)
#   2. Dien thong tin thuc vao .env
#   3. .env KHONG duoc commit vao git (da co trong .gitignore)
#
# Cai python-dotenv de config.py tu dong doc file nay:
#   pip install python-dotenv

# Neo4j Aura credentials
# Lay thong tin tu Neo4j Aura Console: https://console.neo4j.io
NEO4J_URI=neo4j+s://YOUR_INSTANCE_ID.databases.neo4j.io
NEO4J_USER=YOUR_USERNAME
NEO4J_PASSWORD=YOUR_PASSWORD_HERE
