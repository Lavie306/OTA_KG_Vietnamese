        <NamedIndividual IRI="#Word_tuyet_voi"/>
    </ClassAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Word_tuyet_voi</IRI>
        <Literal xml:lang="vi">tuyệt vời</Literal>
    </AnnotationAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#hasSentimentScore"/>
        <NamedIndividual IRI="#Word_tuyet_voi"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#float">1.0</Literal>
    </DataPropertyAssertion>
