<?xml version="1.0"?>
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://www.semanticweb.org/vhera/ontologies/2026/vietnamese-sentiment-ontology-v2"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     ontologyIRI="http://www.semanticweb.org/vhera/ontologies/2026/vietnamese-sentiment-ontology-v2">
    <Prefix name="" IRI="http://www.semanticweb.org/vhera/ontologies/2026/vietnamese-sentiment-ontology-v2/"/>
    <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>
    <Prefix name="rdf" IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
    <Prefix name="xml" IRI="http://www.w3.org/XML/1998/namespace"/>
    <Prefix name="xsd" IRI="http://www.w3.org/2001/XMLSchema#"/>
    <Prefix name="rdfs" IRI="http://www.w3.org/2000/01/rdf-schema#"/>
    <!-- ===================== Class Declarations ===================== -->
    <Declaration>
        <Class IRI="#Words"/>
    </Declaration>
    <Declaration>
        <Class IRI="#predicate"/>
    </Declaration>
    <Declaration>
        <Class IRI="#subject"/>
    </Declaration>
    <Declaration>
        <Class IRI="#Conjunction"/>
    </Declaration>
    <Declaration>
        <Class IRI="#Special_sentence"/>
    </Declaration>
    <Declaration>
        <Class IRI="#Negative_Adverbs"/>
    </Declaration>
    <Declaration>
        <Class IRI="#Negative"/>
    </Declaration>
    <Declaration>
        <Class IRI="#Coordinating"/>
    </Declaration>
    <Declaration>
        <Class IRI="#Prefix"/>
    </Declaration>
    <Declaration>
        <Class IRI="#Subordinating"/>
    </Declaration>
    <Declaration>
        <Class IRI="#Positive"/>
    </Declaration>
    <Declaration>
        <Class IRI="#Sentence"/>
    </Declaration>
    <Declaration>
        <Class IRI="#Emotion"/>
    </Declaration>
    <Declaration>
        <Class IRI="#SentimentAnalysis"/>
    </Declaration>
    <Declaration>
        <Class IRI="#IntensifiersAndNegators"/>
    </Declaration>
    <Declaration>
        <Class IRI="#EmotionWords"/>
    </Declaration>
    <!-- ===================== Data Property ===================== -->
    <Declaration>
        <DataProperty IRI="#hasSentimentScore"/>
    </Declaration>
    <!-- ===================== Class Hierarchy ===================== -->
    <SubClassOf>
        <Class IRI="#Conjunction"/>
        <Class IRI="#Words"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#Coordinating"/>
        <Class IRI="#Conjunction"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#Negative"/>
        <Class IRI="#Words"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#Negative_Adverbs"/>
        <Class IRI="#Words"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#Positive"/>
        <Class IRI="#Words"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#Prefix"/>
        <Class IRI="#Words"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#Special_sentence"/>
        <Class IRI="#Sentence"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#Subordinating"/>
        <Class IRI="#Conjunction"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#Words"/>
        <Class IRI="#Sentence"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#predicate"/>
        <Class IRI="#Sentence"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#subject"/>
        <Class IRI="#Sentence"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#Emotion"/>
        <Class IRI="#Sentence"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#SentimentAnalysis"/>
        <Class IRI="#Negative"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#SentimentAnalysis"/>
        <Class IRI="#Positive"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#IntensifiersAndNegators"/>
        <Class IRI="#Words"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#EmotionWords"/>
        <Class IRI="#Words"/>
    </SubClassOf>
    <!-- ===================== Vietnamese Labels ===================== -->
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Words</IRI>
        <Literal xml:lang="vi">Từ</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#predicate</IRI>
        <Literal xml:lang="vi">Vị ngữ</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#subject</IRI>
        <Literal xml:lang="vi">Chủ ngữ</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Conjunction</IRI>
        <Literal xml:lang="vi">Liên từ</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Special_sentence</IRI>
        <Literal xml:lang="vi">Câu đặc biệt</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Negative_Adverbs</IRI>
        <Literal xml:lang="vi">Phó từ phủ định</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Negative</IRI>
        <Literal xml:lang="vi">Tiêu cực</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Coordinating</IRI>
        <Literal xml:lang="vi">Liên từ đẳng lập</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Prefix</IRI>
        <Literal xml:lang="vi">Tiền tố</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Subordinating</IRI>
        <Literal xml:lang="vi">Liên từ phụ thuộc</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Positive</IRI>
        <Literal xml:lang="vi">Tích cực</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Sentence</IRI>
        <Literal xml:lang="vi">Câu</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Emotion</IRI>
        <Literal xml:lang="vi">Cảm xúc</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#SentimentAnalysis</IRI>
        <Literal xml:lang="vi">Phân tích cảm xúc</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#IntensifiersAndNegators</IRI>
        <Literal xml:lang="vi">Từ tăng cường và phủ định</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#EmotionWords</IRI>
        <Literal xml:lang="vi">Từ cảm xúc</Literal>
    </AnnotationAssertion>
